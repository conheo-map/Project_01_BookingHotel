        <mxCell id="cls_StaffProfile" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Segoe UI,Arial,sans-serif; color:#000000; font-size:9.5px; line-height:13.5px;&quot;&gt;&lt;tr style=&quot;background-color:#E0E0E0; border-bottom:1.2px solid #707070; height:24px;&quot;&gt;&lt;td style=&quot;padding:2px 4px; text-align:center; vertical-align:middle;&quot;&gt;&lt;div style=&quot;font-size:8.5px; font-style:italic; color:#444444; line-height:11px;&quot;&gt;«Entity»&lt;/div&gt;&lt;b style=&quot;font-size:10.5px; color:#000000; line-height:13px;&quot;&gt;StaffProfile&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FFFFFF; border-bottom:1.2px solid #707070;&quot;&gt;&lt;td style=&quot;padding:3px 6px; text-align:left; vertical-align:top; line-height:13.5px;&quot;&gt;&lt;div style=&quot;&quot;&gt;- staffCode: String&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- fullName: String&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- phone: String&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- department: String&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FFFFFF;&quot;&gt;&lt;td style=&quot;padding:3px 6px; text-align:left; vertical-align:top; line-height:13.5px;&quot;&gt;&lt;div&gt;+ tiepNhanCaTruc(): void&lt;/div&gt;&lt;div&gt;+ traCuuLichSuCaTruc(): List&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#707070;strokeWidth=1.2;shadow=0;" vertex="1" parent="1">
