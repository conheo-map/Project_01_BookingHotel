        <!-- ==================== TIÊU ĐỀ BIỂU ĐỒ ==================== -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 16px; color: #000000;&quot;&gt;HỆ THỐNG QUẢN LÝ VÀ ĐẶT PHÒNG SÀI GÒN - CÔN ĐẢO RESORT&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 13px; color: #1E293B;&quot;&gt;BIỂU ĐỒ TRIỂN KHAI VẬT LÝ HỆ THỐNG (UML 2.x DEPLOYMENT DIAGRAM - MINIMALIST ACADEMIC STANDARD)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;spacingLeft=10;" vertex="1" parent="1">
